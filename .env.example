# Copy to .env and fill in. Never commit .env.

# App
APP_NAME=CareerMirror
LOG_LEVEL=INFO

# Auth: JWT_SECRET must be at least 32 characters
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=8
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Storage (docker compose overrides these to paths on the api-data volume)
DATABASE_URL=sqlite+aiosqlite:///./var/app.db
RAG_DB_PATH=./var/rag.db
DATA_DIR=../data

# Retrieval
EMBED_MODEL=

# LLM
GROQ_API_KEY=
GROQ_MODEL=
LLM_TIMEOUT_S=30

# Daily quota per user (FR-23)
QUOTA_DAILY_REQUESTS=30
QUOTA_DAILY_TOKENS=60000
QUOTA_TZ=Asia/Bangkok

# Role matching (FR-19)
MATCH_THRESHOLD=60
TOP_N_ROLES=5

# Market data cache (FR-22)
CACHE_MAX_AGE_DAYS=7
REFRESH_DAILY_CAP=20
APIFY_TOKEN=
APIFY_JOBTHAI_ACTOR=

# web
API_BASE_URL=http://api:8000
